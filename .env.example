# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rethink

# Codeforces API
CF_API_BASE_URL=https://codeforces.com/api
CF_REQUESTS_PER_SECOND=2

# Sync
SYNC_LEASE_MINUTES=15
SYNC_PAGE_SIZE=100

# LLM
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview
DAILY_LLM_CALL_CAP=200

# Security & Deployment
API_KEY=generate_random_32_byte_token_here
# Set DEBUG=False before deploying publicly.
DEBUG=False
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
COACH_RATE_LIMIT_SECONDS=3.0
